APP_ENV = prod
NITRO_PORT = 3000
NITRO_SHUTDOWN_DISABLED = true

# 登录密码加密密钥对：默认读取运行目录（.server）下的 secrets/auth-rsa-*.pem，
# 由 pnpm gen:secrets 生成到 resource/secrets/ 后随 build:server 整目录复制而来，无需在此配置。
# 若改用外部挂载，可把这两个变量设为 PEM 文件路径（相对路径以运行目录为基准）：
# AUTH_RSA_PUBLIC_KEY = /run/secrets/auth-rsa-public.pem
# AUTH_RSA_PRIVATE_KEY = /run/secrets/auth-rsa-private.pem
