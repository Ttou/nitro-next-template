{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "baseUrl": ".",
    "paths": {
      "~db/*": ["db/*"],
      "~server/*": ["server/*"],
      "~shared/*": ["shared/*"],
      "~fastify-plugins/*": ["fastify-plugins/*"],
      "~nestjs-modules/*": ["nestjs-modules/*"]
    }
  },
  "include": [
    "db/**/*.ts",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "fastify-plugins/**/*.ts",
    "nestjs-modules/**/*.ts",
    "alova.config.ts",
    "tsdown.config.ts",
    "vite.config.ts"
  ]
}
